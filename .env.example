# Public canonical URL of the site (build-time; used for sitemap.xml and robots.txt).
# Changing it requires a redeploy/rebuild.
SITE_URL=https://vidgrab.example.com

# Optional URL subfolder the site is served under (build-time).
# Leave empty when served from the domain root.
PAGES_BASE_PATH=

# Host loopback port for the web container (bound to 127.0.0.1 only).
HOST_PORT=3101
